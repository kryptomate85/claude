# --- Data source --------------------------------------------------------------
# dukascopy (default) and yahoo need no key; yahoo covers the last 60 days only. Set oanda to use OANDA, which needs both secrets below.
# DATA_SOURCE=dukascopy
# OANDA_API_KEY=your-oanda-v20-token
# OANDA_ACCOUNT_ID=101-004-1234567-001

# --- Optional: Telegram delivery (set both, or neither for console only) --
# TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
# TELEGRAM_CHAT_ID=123456789

# --- Optional: LLM analyst (only used with `python main.py --llm`) ---------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=                    # set for any OpenAI-compatible endpoint

# --- Optional overrides (defaults shown) ------------------------------------
# OANDA_ENVIRONMENT=practice          # practice | live
# INSTRUMENT=EUR_USD
# GRANULARITY=M5
# LOOKBACK_DAYS=90
# DATA_DIR=data
# REPORTS_DIR=reports
# BACKTEST_CASH=100000
# BACKTEST_COMMISSION=0.00008         # per side, relative (~0.86 pip at 1.08)
# BACKTEST_LEVERAGE=1
# POSITION_SIZE=0.95                  # fraction of available equity per trade
# OOS_FRACTION=0.3                    # trailing share of days held out of sample
# HTTP_TIMEOUT=20
# AGENT_MAX_STEPS=12
